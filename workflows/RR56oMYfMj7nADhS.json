      "id": "9a0f0335-995e-43d0-9ae4-382ce24d8f80",
      "name": "Format Model URL",
      "type": "n8n-nodes-base.code",
      "position": [
        -304,
        512
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "// Get the model image URL (should be just one)\nconst modelData = $('Format Model URL').all()[0];\nconst modelUrl = modelData.json.url;\n\n// Get all clothing image URLs\nconst clothingData = $('Format Clothing URLs').all();\nconst clothingUrls = clothingData.map(item => item.json.url);\n\n// Get chat_id from the original media group processing\nconst mediaGroupData = $('Process Complete Media Group').all()[0];\nconst chatId = mediaGroupData?.json?.chat_id;\n\n// Create the message content array\nconst messageContent = [\n  {\n    \"type\": \"text\",\n    \"text\": `Generate a single image of the model wearing ALL ${clothingUrls.length} clothing items provided. Combine all the clothing pieces (shirts, pants, shoes, accessories, etc.) onto the model in one cohesive, stylish outfit. The model should be wearing everything shown in the clothing images simultaneously.`\n  },\n  {\n    \"type\": \"image_url\",\n    \"image_url\": {\n      \"url\": modelUrl\n    }\n  }\n];\n\n// Add all clothing images to the message\nclothingUrls.forEach(url => {\n  messageContent.push({\n    \"type\": \"image_url\",\n    \"image_url\": {\n      \"url\": url\n    }\n  });\n});\n\nreturn [{ \n  json: {\n    messageContent: messageContent,\n    clothingCount: clothingUrls.length,\n    chatId: chatId\n  }\n}];"
      },
