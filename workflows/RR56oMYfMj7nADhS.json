    {
      "parameters": {
        "jsCode": "// This node collects all photos from a media group\n// It will be triggered once for each photo, but we need to collect them all\n\nconst mediaGroupId = $json.message.media_group_id;\nconst chatId = $json.message.chat.id;\nconst messageId = $json.message.message_id;\n\n// Store this photo data\nconst photoData = {\n  media_group_id: mediaGroupId,\n  chat_id: chatId,\n  message_id: messageId,\n  file_id: $json.message.photo ? $json.message.photo[$json.message.photo.length-1].file_id : $json.message.document.file_id,\n  timestamp: Date.now()\n};\n\n// Use global storage to collect all photos in this media group\nconst storageKey = `media_group_${mediaGroupId}`;\nlet storedData = $getWorkflowStaticData('global')[storageKey] || { photos: [], processed: false };\n\n// Add this photo to the collection\nstoredData.photos.push(photoData);\nstoredData.lastUpdate = Date.now();\n\n// Save back to storage\n$getWorkflowStaticData('global')[storageKey] = storedData;\n\n// Return info about collection status\nreturn [{\n  json: {\n    media_group_id: mediaGroupId,\n    current_count: storedData.photos.length,\n    photos: storedData.photos,\n    chat_id: chatId,\n    should_process: true // We'll process after the wait\n  }\n}];"
      },
      "id": "a9fc56bc-2815-43e0-88d9-eca493964d4f",
      "name": "Collect Media Group Photos",
      "type": "n8n-nodes-base.code",
      "position": [
        -1632,
        48
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "// After waiting, get all photos from this media group and process them\nconst mediaGroupId = $json.media_group_id;\nconst storageKey = `media_group_${mediaGroupId}`;\nconst storedData = $getWorkflowStaticData('global')[storageKey];\n\nif (!storedData || storedData.processed) {\n  return []; // Skip if already processed\n}\n\n// Mark as processed to prevent duplicate processing\nstoredData.processed = true;\n$getWorkflowStaticData('global')[storageKey] = storedData;\n\n// Return all photos for processing - each item must be wrapped in {json: ...}\nconst items = storedData.photos.map((photo, index) => ({\n  json: {\n    file_id: photo.file_id,\n    index: index,\n    media_group_id: mediaGroupId,\n    chat_id: photo.chat_id,\n    total_photos: storedData.photos.length\n  }\n}));\n\nreturn items;"
      },
