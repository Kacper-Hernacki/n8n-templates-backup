    {
      "parameters": {
        "jsCode": "// Loop over input items and add binary data with correct MIME type\nfor (const item of $input.all()) {\n  // Get the file info from the Telegram response\n  const telegramResult = item.json.result;\n  const filePath = telegramResult.file_path;\n  \n  // Extract file name and extension\n  const fileName = filePath.split('/').pop();  \n  const extension = fileName.split('.').pop().toLowerCase();\n  \n  // Create the binary data with proper MIME type\n  // First make sure item.binary exists\n  if (!item.binary) {\n    item.binary = {};\n  }\n  \n  // Create image field for the HTTP request\n  item.binary.image = {\n    ...item.binary.data,  // Copy any existing binary data\n    fileName: fileName,\n    fileSize: telegramResult.file_size,\n    mimeType: extension === 'png' ? 'image/png' : 'image/jpeg'\n  };\n  \n  // For debugging\n  console.log('Set image field with MIME type:', item.binary.image.mimeType);\n}\n\n// Return all items\nreturn $input.all();"
      },
