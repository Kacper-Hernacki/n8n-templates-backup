      "parameters": {
        "jsCode": "const items = $input.all();\nconst updatedItems = items.map((item, index) => {\n  const base64Url = item?.json?.data;\n  const url = `data:image/png;base64,${base64Url}`;\n  return {\n    json: {  // ✅ Wrap everything in a json object\n      url,\n      index: index,\n      media_group_id: item.json.media_group_id,\n      chat_id: item.json.chat_id\n    }\n  };\n});\nreturn updatedItems;"
      },
