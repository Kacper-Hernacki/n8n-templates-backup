    {
      "parameters": {
        "jsCode": "// Get all clothing URLs\nconst clothingItems = $('Format Clothing URLs').all();\nconst clothingUrls = clothingItems.map(item => item.json.url);\n\n// Get model image data\nconst modelData = $('Convert Model to Base64').first();\nconst modelUrl = `data:image/png;base64,${modelData.json.data}`;\n\n// Get chat_id from the first clothing item\nconst chatId = clothingItems[0]?.json?.chat_id;\n\n// Create the message content array\nconst messageContent = [\n  {\n    \"type\": \"text\",\n    \"text\": `Generate a single image of the model wearing ALL ${clothingUrls.length} clothing items provided. Combine all the clothing pieces (shirts, pants, shoes, accessories, etc.) onto the model in one cohesive, stylish outfit. The model should be wearing everything shown in the clothing images simultaneously.`\n  },\n  {\n    \"type\": \"image_url\",\n    \"image_url\": {\n      \"url\": modelUrl\n    }\n  }\n];\n\n// Add all clothing images to the message\nclothingUrls.forEach(url => {\n  messageContent.push({\n    \"type\": \"image_url\",\n    \"image_url\": {\n      \"url\": url\n    }\n  });\n});\n\nreturn [{ \n  json: {\n    messageContent: messageContent,\n    clothingCount: clothingUrls.length,\n    chatId: chatId\n  }\n}];"
      },
